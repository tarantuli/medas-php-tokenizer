    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-console": "^4",
    "morphp/medas-core": "^4",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-console-printer": "^4|^5",
    "morphp/medas-object-instantiator": "^4",
